  {%- when 'watch' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="6"/><polyline points="12 10 12 12 13 13"/><path d="M16.51 17.35 16 22l-1.5-1.5L13 22l-1.5-1.5L10 22l-.51-4.65M7.49 6.65 8 2l1.5 1.5L11 2l1.5 1.5L14 2l.51 4.65"/></svg>
