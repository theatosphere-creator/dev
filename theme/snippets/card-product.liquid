{%- comment -%}
  Renders a product card.
  Usage: {% render 'card-product', card_product: product %}
  Optional: ratio (square|portrait|landscape)
{%- endcomment -%}
{%- liquid
  assign p = card_product
  assign ratio = ratio | default: settings.card_image_ratio
  assign lazy = 'eager'
  if settings.enable_lazy_loading
    assign lazy = 'lazy'
  endif
-%}

{%- if p and p != empty -%}
  <div class="card-product scroll-trigger">
    <a href="{{ p.url }}" class="card-product__media card-product__media--{{ ratio }}" aria-label="{{ p.title }}">
      {%- if p.featured_media -%}
        <img
          src="{{ p.featured_media | image_url: width: 600 }}"
          srcset="{{ p.featured_media | image_url: width: 300 }} 300w, {{ p.featured_media | image_url: width: 600 }} 600w, {{ p.featured_media | image_url: width: 900 }} 900w"
          sizes="(min-width: 990px) 25vw, 50vw"
          alt="{{ p.featured_media.alt | escape | default: p.title }}"
          width="600" height="600"
          loading="{{ lazy }}"
          class="card-product__image"
        >
        {%- if settings.card_hover_second_image and p.media[1] -%}
          <img
            src="{{ p.media[1] | image_url: width: 600 }}"
            alt=""
            width="600" height="600"
            loading="lazy"
            class="card-product__image card-product__image--hover"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'card-product__image' }}
      {%- endif -%}

      <div class="card-product__badges">
        {%- if p.compare_at_price > p.price -%}
          {%- assign savings = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}
          <span class="badge badge--sale">-{{ savings }}%</span>
        {%- endif -%}
        {%- if p.available == false -%}
          <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif p.tags contains 'new' -%}
          <span class="badge badge--new">{{ 'products.product.new' | t }}</span>
        {%- endif -%}
      </div>
    </a>

    <button type="button" class="card-product__wishlist" data-wishlist-toggle="{{ p.id }}" aria-label="Add to wishlist">
      {% render 'icon', name: 'heart' %}
    </button>

    {%- if settings.card_quick_add and p.available -%}
      <div class="card-product__quick-add">
        {%- if p.variants.size > 1 -%}
          <a href="{{ p.url }}" class="button button--full button--small">{{ 'products.product.choose_options' | t }}</a>
        {%- else -%}
          <form data-quick-add-form>
            <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
            <button type="submit" class="button button--accent button--full button--small">{{ 'products.product.quick_add' | t }}</button>
          </form>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="card-product__info">
      {%- if settings.card_show_vendor and p.vendor != blank -%}
        <span class="card-product__vendor">{{ p.vendor }}</span>
      {%- endif -%}
      <a href="{{ p.url }}" class="card-product__title">{{ p.title }}</a>
      {%- if settings.card_show_rating -%}
        {% render 'rating', product: p %}
      {%- endif -%}
      {% render 'price', product: p %}
    </div>
  </div>
{%- endif -%}
