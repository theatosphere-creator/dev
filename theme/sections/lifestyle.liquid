<div class="section{% if section.settings.full_width %}{% else %} page-width{% endif %}">
  <div class="feature-split scroll-trigger{% if section.settings.dark %} feature-split--dark{% endif %}{% if section.settings.reverse %} feature-split--reverse{% endif %}" style="{% unless section.settings.full_width %}border-radius:var(--card-radius);overflow:hidden;{% endunless %}{% if section.settings.reverse %}direction:rtl;{% endif %}">
    <div class="feature-split__media" style="direction:ltr;{% if section.settings.reverse %}order:2;{% endif %}">
      {%- if section.settings.video != blank -%}
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.video.sources[1].url | default: section.settings.video.sources[0].url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" width="800" height="600" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="feature-split__content" style="direction:ltr;">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p style="{% if section.settings.dark %}color:rgba(255,255,255,0.8);{% else %}color:var(--color-text-muted);{% endif %}max-width:44ch;">{{ section.settings.text }}</p>{%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div style="display:flex;gap:1rem;align-items:flex-start;margin-bottom:1.2rem;" {{ block.shopify_attributes }}>
            <span style="color:var(--color-accent);flex-shrink:0;">{% render 'icon', name: block.settings.icon %}</span>
            <div>
              <strong>{{ block.settings.title }}</strong>
              {%- if block.settings.text != blank -%}<div style="font-size:1.4rem;opacity:0.8;">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.button_label != blank -%}
        <div style="margin-top:1.6rem;"><a href="{{ section.settings.button_link }}" class="button {% if section.settings.dark %}button--inverse{% else %}button--accent{% endif %}">{{ section.settings.button_label }}</a></div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by lifestyle",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video (overrides image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lifestyle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for every moment" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From morning runs to late-night sessions, Aether adapts to your life with sweat resistance, all-day battery and immersive sound." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the range" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout", "default": false },
    { "type": "checkbox", "id": "dark", "label": "Dark theme", "default": true },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "headphones", "label": "Headphones" },
            { "value": "speaker", "label": "Speaker" },
            { "value": "watch", "label": "Watch" },
            { "value": "shield", "label": "Shield" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check", "label": "Check" }
          ], "default": "check"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "All-day battery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Up to 40 hours of playback." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by lifestyle",
      "blocks": [
        { "type": "feature", "settings": { "icon": "shield", "title": "IPX7 water resistant" } },
        { "type": "feature", "settings": { "icon": "refresh", "title": "40h battery life" } },
        { "type": "feature", "settings": { "icon": "headphones", "title": "Adaptive ANC" } }
      ]
    }
  ]
}
{% endschema %}
