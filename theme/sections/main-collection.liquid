{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}

{%- comment -%} Banner {%- endcomment -%}
<div class="collection-banner">
  {%- if section.settings.show_image and collection.image -%}
    <img src="{{ collection.image | image_url: width: 2000 }}" alt="{{ collection.title | escape }}" width="2000" height="600" fetchpriority="high">
  {%- endif -%}
  <div class="collection-banner__content page-width">
    <span class="eyebrow" style="color:var(--color-accent);">Collection</span>
    <h1 style="margin:0;">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte" style="max-width:60ch;margin:1rem auto 0;opacity:0.85;">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

{% render 'breadcrumbs' %}

{%- paginate collection.products by section.settings.products_per_page -%}
<div class="page-width section-sm" data-infinite-scroll>
  <div class="collection-layout">
    {%- comment -%} Sidebar facets {%- endcomment -%}
    {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
      <aside class="facets-wrapper" data-facets>
        {% render 'facets', filters: collection.filters, sort_by: sort_by, results_url: collection.url %}
      </aside>
    {%- endif -%}

    <div>
      <div class="collection-toolbar">
        <div style="display:flex;align-items:center;gap:1rem;">
          {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
            <button type="button" class="button button--secondary button--small facets-mobile-toggle" onclick="document.querySelector('[data-facets]').classList.toggle('is-open')">
              {% render 'icon', name: 'menu', size: 16 %} {{ 'collections.filters.title' | t }}
            </button>
          {%- endif -%}
          <span class="collection-toolbar__count">{{ collection.products_count }} {{ 'collections.general.items_with_count_plural' | t: count: collection.products_count }}</span>
        </div>

        {%- if section.settings.enable_sorting -%}
          <form data-sort-form method="get">
            <label for="SortBy" class="visually-hidden">{{ 'collections.sorting.title' | t }}</label>
            <select id="SortBy" name="sort_by" onchange="this.form.submit()">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
            {%- for filter in collection.filters -%}
              {%- for v in filter.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value -%}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}">{%- endif -%}
                {%- if filter.max_value.value -%}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}">{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </form>
        {%- endif -%}
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="product-grid product-grid--{{ section.settings.columns }}" data-product-grid>
          {%- for product in collection.products -%}
            {% render 'card-product', card_product: product, ratio: section.settings.image_ratio %}
          {%- endfor -%}
        </div>

        {%- if paginate.next -%}
          <div data-infinite-sentinel data-next-url="{{ paginate.next.url }}" style="height:1px;"></div>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'collections.general.no_matches' | t }}</p>
          <a href="{{ collection.url }}" class="button button--accent">{{ 'collections.filters.clear_all' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Show collection banner image", "default": true },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 36, "step": 4, "default": 16 },
    {
      "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 4
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ], "default": "square"
    },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filters", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true }
  ]
}
{% endschema %}
