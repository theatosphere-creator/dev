<div class="announcement-bar" style="{% if section.settings.bg %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.color %}color:{{ section.settings.color }};{% endif %}">
  <div class="announcement-bar__inner">
    {%- for block in section.blocks -%}
      <span class="announcement-bar__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "color", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on all orders" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "award", "label": "Award" },
            { "value": "refresh", "label": "Returns" },
            { "value": "lock", "label": "Lock" }
          ],
          "default": "truck"
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
