<div class="page-width section">
  <div class="section-header section-header--center scroll-trigger">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="section-header__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.handle != blank -%}
      <a href="{{ settings.social_instagram | default: '#' }}" class="link" style="margin-top:1rem;">{{ section.settings.handle }}</a>
    {%- endif -%}
  </div>
  <div class="instagram-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: settings.social_instagram | default: '#' }}" class="instagram-grid__item scroll-trigger" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 400 }}" alt="Instagram post" width="200" height="200" loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Instagram feed",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Follow us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "#AetherSound" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@aether" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Instagram feed",
      "blocks": [
        { "type": "post" }, { "type": "post" }, { "type": "post" },
        { "type": "post" }, { "type": "post" }, { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
