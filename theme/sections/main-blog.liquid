{%- paginate blog.articles by 9 -%}
<div class="page-width section">
  <div class="section-header section-header--center">
    <span class="eyebrow">Journal</span>
    <h1 class="section-header__title">{{ blog.title }}</h1>
  </div>

  {%- if blog.all_tags.size > 0 and section.settings.show_tags -%}
    <div style="display:flex;gap:0.8rem;flex-wrap:wrap;justify-content:center;margin-bottom:3.2rem;">
      <a href="{{ blog.url }}" class="button button--secondary button--small{% unless current_tags %} button--accent{% endunless %}">All</a>
      {%- for tag in blog.all_tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="button button--secondary button--small{% if current_tags contains tag %} button--accent{% endif %}">{{ tag }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="blog-grid">
    {%- for article in blog.articles -%}
      <article class="article-card scroll-trigger">
        <a href="{{ article.url }}" class="article-card__image">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" width="500" height="312" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
        </a>
        <div class="article-card__meta">
          {%- if article.tags.size > 0 -%}{{ article.tags.first }} &middot; {% endif %}{{ article.published_at | date: '%b %d, %Y' }}
        </div>
        <a href="{{ article.url }}"><h2 class="article-card__title">{{ article.title }}</h2></a>
        <p class="text-muted">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
        <a href="{{ article.url }}" class="link" style="margin-top:0.8rem;">{{ 'blogs.article.read_more' | t }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>
      </article>
    {%- endfor -%}
  </div>
  {% render 'pagination', paginate: paginate %}
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "checkbox", "id": "show_tags", "label": "Show category filter", "default": true }
  ]
}
{% endschema %}
