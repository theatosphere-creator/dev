{%- liquid
  assign coll = section.settings.collection
  assign products = coll.products
  assign limit = section.settings.products_to_show
  assign is_slider = false
  if section.settings.layout == 'slider'
    assign is_slider = true
  endif
-%}
<div class="page-width section">
  <slider-controls>
    <div class="slider-header scroll-trigger">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 style="margin:0;">{{ section.settings.heading }}</h2>
        {%- if section.settings.subtext != blank -%}<p class="text-muted" style="margin:0.6rem 0 0;">{{ section.settings.subtext }}</p>{%- endif -%}
      </div>
      <div style="display:flex;gap:1.6rem;align-items:center;">
        {%- if section.settings.view_all and coll.url -%}
          <a href="{{ coll.url }}" class="link">View all</a>
        {%- endif -%}
        {%- if is_slider -%}
          <div class="slider-controls">
            <button class="slider-button" type="button" data-slider-prev aria-label="{{ 'general.accessibility.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
            <button class="slider-button" type="button" data-slider-next aria-label="{{ 'general.accessibility.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if products.size > 0 -%}
      <div class="{% if is_slider %}slider slider--products{% else %}product-grid product-grid--4{% endif %}" data-slider>
        {%- for product in products limit: limit -%}
          {% render 'card-product', card_product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-grid product-grid--4">
        {%- for i in (1..4) -%}
          <div class="card-product">
            <div class="card-product__media">{{ 'product-1' | placeholder_svg_tag: 'card-product__image' }}</div>
            <div class="card-product__info"><span class="card-product__title">Example product</span><span class="card-product__price">$199.00</span></div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </slider-controls>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "subtext", "label": "Subtext" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 8 },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "slider", "label": "Slider / Carousel" },
        { "value": "grid", "label": "Grid" }
      ], "default": "slider"
    },
    { "type": "checkbox", "id": "view_all", "label": "Show 'View all' link", "default": true }
  ],
  "presets": [
    { "name": "Best sellers slider", "settings": { "heading": "Best sellers", "eyebrow": "Bestsellers", "layout": "slider" } },
    { "name": "New arrivals carousel", "settings": { "heading": "New arrivals", "eyebrow": "Just dropped", "layout": "slider" } },
    { "name": "Trending products", "settings": { "heading": "Trending now", "eyebrow": "Hot right now", "layout": "grid" } }
  ]
}
{% endschema %}
