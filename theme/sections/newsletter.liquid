<div class="page-width section">
  <div class="newsletter scroll-trigger" style="{% if section.settings.bg %}background:{{ section.settings.bg }};{% endif %}{% if section.settings.text_color %}color:{{ section.settings.text_color }};{% endif %}">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p style="max-width:48ch;margin:0 auto;opacity:0.85;">{{ section.settings.subtext }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p style="width:100%;text-align:center;">{{ 'general.newsletter_form.confirmation' | t }}</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required aria-label="Email">
        <button type="submit" class="button button--accent">{{ 'general.newsletter_form.button_label' | t }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay connected" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Aether community" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Subscribe for early access to drops, exclusive offers and audio tips." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
