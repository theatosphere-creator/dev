<div class="page-width section">
  <div class="section-header section-header--center scroll-trigger">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="section-header__title">{{ section.settings.heading }}</h2>
  </div>
  <div class="accordion scroll-trigger" style="max-width:80rem;margin:0 auto;">
    {%- for block in section.blocks -%}
      <details class="accordion__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
        <summary class="accordion__summary">{{ block.settings.question }}</summary>
        <div class="accordion__content rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{%- if section.settings.enable_schema -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open first item", "default": true },
    { "type": "checkbox", "id": "enable_schema", "label": "Output FAQ schema markup", "default": true }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders ship within 24 hours and arrive in 3-5 business days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa" },
        { "type": "qa", "settings": { "question": "What is your return policy?", "answer": "<p>We offer a 30-day hassle-free return policy on all products.</p>" } },
        { "type": "qa", "settings": { "question": "Is there a warranty?", "answer": "<p>Yes, every Aether device includes a 2-year limited warranty.</p>" } }
      ]
    }
  ]
}
{% endschema %}
