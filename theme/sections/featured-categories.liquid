<div class="page-width section">
  <div class="section-header section-header--center scroll-trigger">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="section-header__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p class="section-header__subtext">{{ section.settings.subtext }}</p>{%- endif -%}
  </div>
  <div class="category-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign coll = block.settings.collection
        assign img = block.settings.image
        if img == blank and coll.featured_image
          assign img = coll.featured_image
        endif
        assign url = block.settings.link
        if url == blank and coll.url
          assign url = coll.url
        endif
        assign title = block.settings.title
        if title == blank and coll.title
          assign title = coll.title
        endif
      -%}
      <a href="{{ url | default: '#' }}" class="category-card scroll-trigger" {{ block.shopify_attributes }}>
        {%- if img != blank -%}
          <img src="{{ img | image_url: width: 500 }}" alt="{{ title | escape }}" width="375" height="500" loading="lazy">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag }}
        {%- endif -%}
        <div class="category-card__overlay">
          <h3 class="category-card__title">{{ title | default: 'Category' }}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Find your perfect sound across our curated collections." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Featured categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Earbuds" } },
        { "type": "category", "settings": { "title": "Headphones" } },
        { "type": "category", "settings": { "title": "Speakers" } },
        { "type": "category", "settings": { "title": "Smart Watches" } },
        { "type": "category", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
