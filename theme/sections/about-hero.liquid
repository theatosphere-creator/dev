<div class="hero hero--height-{{ section.settings.height }}" style="margin-bottom:var(--spacing-sections);">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}" width="2000" height="900" fetchpriority="high">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="hero__overlay"></div>
  <div class="page-width">
    <div class="hero__content" style="text-align:center;margin:0 auto;">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__text" style="margin-inline:auto;">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Engineering the future of sound" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Aether was founded on a single belief: that premium audio should be accessible, beautiful and built to last." },
    {
      "type": "select", "id": "height", "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ], "default": "medium"
    }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
