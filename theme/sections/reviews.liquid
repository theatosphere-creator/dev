<div class="page-width section">
  <slider-controls>
    <div class="slider-header scroll-trigger">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 style="margin:0;">{{ section.settings.heading }}</h2>
      </div>
      <div class="slider-controls">
        <button class="slider-button" type="button" data-slider-prev aria-label="{{ 'general.accessibility.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <button class="slider-button" type="button" data-slider-next aria-label="{{ 'general.accessibility.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>
    <div class="slider" data-slider>
      {%- for block in section.blocks -%}
        <div style="width:85%;max-width:42rem;" {{ block.shopify_attributes }}>
          <div class="review-card scroll-trigger">
            {% render 'rating', rating: block.settings.rating %}
            <p class="review-card__text">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <div style="display:flex;align-items:center;gap:1.2rem;">
              {%- if block.settings.avatar != blank -%}
                <img src="{{ block.settings.avatar | image_url: width: 96 }}" alt="{{ block.settings.author | escape }}" width="48" height="48" style="border-radius:50%;" loading="lazy">
              {%- endif -%}
              <div>
                <div class="review-card__author">{{ block.settings.author }}</div>
                <div class="review-card__role">{{ block.settings.role }}</div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </slider-controls>
</div>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by thousands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The sound quality is unreal. Best earbuds I've ever owned, hands down." },
        { "type": "text", "id": "author", "label": "Author", "default": "Alex M." },
        { "type": "text", "id": "role", "label": "Role / location", "default": "Verified buyer" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "quote": "Battery lasts forever and the noise cancelling is incredible on flights.", "author": "Priya S." } },
        { "type": "review", "settings": { "quote": "Premium build, premium sound. Worth every penny.", "author": "Daniel R." } }
      ]
    }
  ]
}
{% endschema %}
