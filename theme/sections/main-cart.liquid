<div class="page-width section">
  <h1 style="margin-bottom:3.2rem;">{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-page__layout">
      <div class="cart-table">
        {%- for item in cart.items -%}
          <div class="cart-row" data-cart-item>
            <a href="{{ item.url }}" class="cart-item__image" style="border-radius:var(--card-radius);overflow:hidden;">
              {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="100" loading="lazy">{%- endif -%}
            </a>
            <div>
              <a href="{{ item.url }}" class="cart-item__title" style="font-size:1.7rem;">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<div class="cart-item__variant">{{ item.variant.title }}</div>{%- endunless -%}
              {%- if item.selling_plan_allocation -%}<div class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</div>{%- endif -%}
              <div style="margin-top:1rem;display:flex;align-items:center;gap:1.6rem;flex-wrap:wrap;">
                <div class="quantity">
                  <button class="quantity__button" type="button" data-quantity-change="decrease" aria-label="{{ 'products.product.decrease_quantity' | t }}">&minus;</button>
                  <input class="quantity__input" type="number" min="0" value="{{ item.quantity }}" data-cart-quantity="{{ forloop.index }}" aria-label="Quantity">
                  <button class="quantity__button" type="button" data-quantity-change="increase" aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
                </div>
                <button type="button" class="cart-item__remove" data-cart-remove="{{ forloop.index }}">{{ 'cart.general.remove' | t }}</button>
              </div>
            </div>
            <div style="text-align:right;">
              {%- if item.original_line_price != item.final_line_price -%}
                <div class="cart-item__price">{{ item.final_line_price | money }}</div>
                <div class="text-muted"><del>{{ item.original_line_price | money }}</del></div>
              {%- else -%}
                <div class="cart-item__price">{{ item.final_line_price | money }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}

        {%- if settings.cart_show_note -%}
          <div style="margin-top:2.4rem;">
            <label for="CartNote" class="field__label">{{ 'cart.general.note' | t }}</label>
            <textarea name="note" id="CartNote" form="cart">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      </div>

      <aside class="cart-summary">
        <h2 style="font-size:2rem;margin-bottom:1.6rem;">Order summary</h2>

        {%- if settings.cart_show_coupon -%}
          <div class="field">
            <label class="field__label" for="CartDiscount">{{ 'cart.general.discount' | t }}</label>
            <input type="text" id="CartDiscount" placeholder="Promo code">
            <p class="text-muted" style="font-size:1.2rem;margin-top:0.6rem;">{{ 'cart.general.coupon_hint' | t }}</p>
          </div>
        {%- endif -%}

        {%- if settings.cart_show_shipping_calc -%}
          <p class="text-muted" style="font-size:1.3rem;display:flex;align-items:center;gap:0.5rem;">{% render 'icon', name: 'truck', size: 18 %} {{ 'cart.general.shipping_hint' | t }}</p>
        {%- endif -%}

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-summary__row" style="color:var(--color-accent);"><span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
        {%- endif -%}

        <div class="cart-summary__row"><span>{{ 'cart.general.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <div class="cart-summary__total cart-summary__row"><span>{{ 'cart.general.estimated_total' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <p class="text-muted" style="font-size:1.2rem;">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>

        <button type="submit" name="checkout" class="button button--accent button--full" style="margin-top:1.2rem;">{{ 'cart.general.checkout' | t }}</button>

        {%- if settings.enable_dynamic_checkout -%}
          <div style="margin-top:1rem;">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}

        {%- if settings.show_trust_badges -%}
          <div class="trust-badges" style="margin-top:2rem;">
            <span class="trust-badges__item">{% render 'icon', name: 'lock' %} Secure</span>
            <span class="trust-badges__item">{% render 'icon', name: 'shield' %} Warranty</span>
            <span class="trust-badges__item">{% render 'icon', name: 'refresh' %} Returns</span>
          </div>
        {%- endif -%}
      </aside>
    </form>

    {%- if section.settings.show_upsell and section.settings.upsell_collection != blank -%}
      <div class="section">
        <h2 style="margin-bottom:2rem;">{{ 'cart.general.you_might_like' | t }}</h2>
        <div class="slider slider--products" data-slider>
          {%- for product in section.settings.upsell_collection.products limit: 8 -%}
            {% render 'card-product', card_product: product %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  {%- else -%}
    <div class="empty-state">
      {% render 'icon', name: 'cart', size: 56 %}
      <h2>{{ 'cart.general.empty' | t }}</h2>
      <a href="{{ routes.all_products_collection_url }}" class="button button--accent">{{ 'cart.general.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "checkbox", "id": "show_upsell", "label": "Show upsell products", "default": true },
    { "type": "collection", "id": "upsell_collection", "label": "Upsell collection" }
  ]
}
{% endschema %}
