{%- liquid
  assign rows = section.settings.rows | newline_to_br | split: '<br />'
-%}
<div class="page-width section">
  <div class="section-header section-header--center scroll-trigger">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="section-header__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p class="section-header__subtext">{{ section.settings.subtext }}</p>{%- endif -%}
  </div>
  <div class="comparison scroll-trigger">
    <table>
      <thead>
        <tr>
          <th>{{ section.settings.feature_col_label }}</th>
          {%- for block in section.blocks -%}
            <th class="{% if block.settings.featured %}is-featured{% endif %}" {{ block.shopify_attributes }}>
              {{ block.settings.name }}
              {%- if block.settings.featured -%}<div class="badge badge--sale" style="margin-top:0.5rem;">Recommended</div>{%- endif -%}
            </th>
          {%- endfor -%}
        </tr>
      </thead>
      <tbody>
        {%- for row in rows -%}
          {%- assign cells = row | strip | split: '|' -%}
          {%- if cells.size > 0 and cells[0] != blank -%}
            <tr>
              <th>{{ cells[0] | strip }}</th>
              {%- for block in section.blocks -%}
                {%- assign idx = forloop.index -%}
                {%- assign val = cells[idx] | strip -%}
                <td class="{% if block.settings.featured %}is-featured{% endif %}">
                  {%- if val == 'yes' or val == 'Yes' -%}
                    <span class="comparison__check">{% render 'icon', name: 'check', size: 20 %}</span>
                  {%- elsif val == 'no' or val == 'No' -%}
                    <span class="comparison__cross">&mdash;</span>
                  {%- else -%}
                    {{ val }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Product comparison",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your perfect match" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Compare features across our flagship lineup." },
    { "type": "text", "id": "feature_col_label", "label": "Feature column label", "default": "Features" },
    {
      "type": "textarea", "id": "rows", "label": "Rows",
      "info": "One row per line. Separate cells with | . First cell is the feature name. Use 'yes' or 'no' for checkmarks.",
      "default": "Active Noise Cancellation | yes | yes | no\nBattery life | 40h | 30h | 24h\nWater resistance | IPX7 | IPX5 | IPX4\nWireless charging | yes | no | no\nPrice | $299 | $199 | $99"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Product column",
      "settings": [
        { "type": "text", "id": "name", "label": "Product name", "default": "Aether Pro" },
        { "type": "checkbox", "id": "featured", "label": "Highlight column", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Product comparison",
      "blocks": [
        { "type": "column", "settings": { "name": "Aether Pro", "featured": true } },
        { "type": "column", "settings": { "name": "Aether Plus" } },
        { "type": "column", "settings": { "name": "Aether Lite" } }
      ]
    }
  ]
}
{% endschema %}
