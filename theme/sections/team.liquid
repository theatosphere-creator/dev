<div class="page-width section">
  <div class="section-header section-header--center scroll-trigger">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="section-header__title">{{ section.settings.heading }}</h2>
  </div>
  <div class="team-grid">
    {%- for block in section.blocks -%}
      <div class="team-card scroll-trigger" {{ block.shopify_attributes }}>
        <div class="team-card__image">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.name | escape }}" width="375" height="500" loading="lazy">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <h3 style="font-size:1.8rem;margin:0;">{{ block.settings.name }}</h3>
        <p class="text-muted" style="margin:0.2rem 0 0;">{{ block.settings.role }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Team",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The people" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the team" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Jane Doe" },
        { "type": "text", "id": "role", "label": "Role", "default": "Founder & CEO" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team",
      "blocks": [ { "type": "member" }, { "type": "member" }, { "type": "member" }, { "type": "member" } ]
    }
  ]
}
{% endschema %}
