{% render 'breadcrumbs' %}
<div class="page-width section">
  <div class="section-header section-header--center scroll-trigger">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="section-header__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.subtext != blank -%}<p class="section-header__subtext">{{ section.settings.subtext }}</p>{%- endif -%}
  </div>

  <div class="contact-layout">
    <div>
      {%- form 'contact' -%}
        {%- if form.posted_successfully? -%}
          <p style="padding:1.6rem;background:rgba(10,125,60,0.1);border-radius:var(--button-radius);">{{ 'contact.form.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p style="padding:1.6rem;background:rgba(255,77,0,0.1);border-radius:var(--button-radius);">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="ContactName">{{ 'contact.form.name' | t }}</label>
          <input type="text" id="ContactName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
        </div>
        <div class="field">
          <label class="field__label" for="ContactEmail">{{ 'contact.form.email' | t }}</label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
        </div>
        <div class="field">
          <label class="field__label" for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
          <input type="tel" id="ContactPhone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% endif %}">
        </div>
        <div class="field">
          <label class="field__label" for="ContactMessage">{{ 'contact.form.message' | t }}</label>
          <textarea id="ContactMessage" name="contact[body]" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>
        <button type="submit" class="button button--accent">{{ 'contact.form.send' | t }}</button>
      {%- endform -%}

      {%- if section.settings.show_support -%}
        <div style="margin-top:3.2rem;display:grid;gap:1.6rem;">
          {%- if section.settings.email != blank -%}<div style="display:flex;gap:1rem;align-items:center;">{% render 'icon', name: 'support' %} <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></div>{%- endif -%}
          {%- if section.settings.phone != blank -%}<div style="display:flex;gap:1rem;align-items:center;">{% render 'icon', name: 'shield' %} {{ section.settings.phone }}</div>{%- endif -%}
          {%- if section.settings.address != blank -%}<div style="display:flex;gap:1rem;align-items:flex-start;">{% render 'icon', name: 'globe' %} <span>{{ section.settings.address }}</span></div>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.map_embed != blank -%}
      <div class="contact-map">{{ section.settings.map_embed }}</div>
    {%- elsif section.settings.map_address != blank -%}
      <div class="contact-map">
        <iframe loading="lazy" allowfullscreen src="https://maps.google.com/maps?q={{ section.settings.map_address | url_encode }}&output=embed" title="Map"></iframe>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Questions about a product or order? Our team is here to help." },
    { "type": "header", "content": "Support details" },
    { "type": "checkbox", "id": "show_support", "label": "Show support details", "default": true },
    { "type": "text", "id": "email", "label": "Support email", "default": "support@aether.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+1 (800) 123-4567" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "100 Sound Avenue, Suite 200, New York, NY" },
    { "type": "header", "content": "Map" },
    { "type": "text", "id": "map_address", "label": "Map address (Google Maps)", "default": "New York, NY" },
    { "type": "html", "id": "map_embed", "label": "Map embed code (overrides address)" }
  ]
}
{% endschema %}
