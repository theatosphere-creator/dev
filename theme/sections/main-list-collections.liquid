<div class="page-width section">
  <div class="section-header section-header--center">
    <h1 class="section-header__title">{{ section.settings.heading }}</h1>
  </div>
  <div class="category-grid">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="category-card scroll-trigger">
        {%- if collection.featured_image -%}
          <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title | escape }}" width="375" height="500" loading="lazy">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag }}
        {%- endif -%}
        <div class="category-card__overlay"><h3 class="category-card__title">{{ collection.title }}</h3></div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" }
  ]
}
{% endschema %}
