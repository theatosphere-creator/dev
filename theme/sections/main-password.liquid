<div class="password-page__inner">
  <h1 class="footer__brand-name" style="font-size:4rem;">{{ shop.name }}</h1>
  <p style="font-size:1.8rem;opacity:0.8;">{{ section.settings.heading }}</p>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<p style="color:var(--color-accent);">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="newsletter__form" style="margin:2rem auto 0;">
      <input type="password" name="password" placeholder="Enter store password" aria-label="Password" required>
      <button type="submit" class="button button--accent">Enter</button>
    </div>
  {%- endform -%}

  <p style="margin-top:3rem;opacity:0.6;font-size:1.3rem;">Are you the store owner? <a href="/admin" style="color:var(--color-accent);">Log in here</a></p>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something incredible is coming. Enter the password to take a look." }
  ]
}
{% endschema %}
