<div class="page-width section">
  <div class="auth-card">
    <h1 style="text-align:center;">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}<p style="color:var(--color-accent);">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field">
        <label class="field__label" for="FirstName">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" id="FirstName" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="LastName">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" id="LastName" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegEmail">{{ 'customer.register.email' | t }}</label>
        <input type="email" id="RegEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegPassword">{{ 'customer.register.password' | t }}</label>
        <input type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--accent button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
    <p style="text-align:center;margin-top:1.6rem;">Already have an account? <a href="{{ routes.account_login_url }}" class="link">{{ 'customer.login_page.sign_in' | t }}</a></p>
  </div>
</div>
