<div class="page-width section">
  <a href="{{ routes.account_url }}" class="link" style="border:0;">&larr; {{ 'customer.account.return' | t }}</a>
  <h1 style="margin-top:1rem;">{{ 'customer.addresses.title' | t }}</h1>

  {%- comment -%} New address {%- endcomment -%}
  <details style="margin:2rem 0;">
    <summary class="button button--accent" style="display:inline-flex;list-style:none;">{{ 'customer.addresses.add_new' | t }}</summary>
    <div class="auth-card" style="margin:1.6rem 0 0;max-width:100%;">
      {%- form 'customer_address', customer.new_address -%}
        {% render 'address-fields', form: form %}
        <label style="display:flex;gap:0.6rem;align-items:center;margin:1rem 0;"><input type="checkbox" name="address[default]" value="1" style="width:auto;"> {{ 'customer.addresses.set_default' | t }}</label>
        <button type="submit" class="button button--accent">{{ 'customer.addresses.add' | t }}</button>
      {%- endform -%}
    </div>
  </details>

  {%- for address in customer.addresses -%}
    <div class="auth-card" style="max-width:100%;margin-bottom:1.6rem;">
      {%- if address == customer.default_address -%}<span class="badge badge--sale">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
      <p style="margin-top:1rem;">{{ address | format_address }}</p>
      <div style="display:flex;gap:1rem;">
        <details>
          <summary class="button button--secondary button--small" style="list-style:none;">{{ 'customer.addresses.edit' | t }}</summary>
          <div style="margin-top:1.6rem;">
            {%- form 'customer_address', address -%}
              {% render 'address-fields', form: form %}
              <label style="display:flex;gap:0.6rem;align-items:center;margin:1rem 0;"><input type="checkbox" name="address[default]" value="1" style="width:auto;"{% if address == customer.default_address %} checked{% endif %}> {{ 'customer.addresses.set_default' | t }}</label>
              <button type="submit" class="button button--accent">{{ 'customer.addresses.update' | t }}</button>
            {%- endform -%}
          </div>
        </details>
        {%- form 'customer_address', address, method: 'delete' -%}
          <button type="submit" class="button button--secondary button--small" onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t }}');">{{ 'customer.addresses.delete' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  {%- endfor -%}
</div>

<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Shopify === 'undefined' || !Shopify.CountryProvinceSelector) return;
    document.querySelectorAll('[id^="AddressCountry_"]').forEach(function (el) {
      var id = el.id.replace('AddressCountry_', '');
      new Shopify.CountryProvinceSelector('AddressCountry_' + id, 'AddressProvince_' + id, {
        hideElement: 'AddressProvinceContainer_' + id
      });
    });
  });
</script>
