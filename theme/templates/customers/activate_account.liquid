<div class="page-width section">
  <div class="auth-card">
    <h1 style="text-align:center;">Activate account</h1>
    <p class="text-muted" style="text-align:center;">Create your password to activate your account.</p>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}<p style="color:var(--color-accent);">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field">
        <label class="field__label" for="ActivatePassword">{{ 'customer.login_page.password' | t }}</label>
        <input type="password" id="ActivatePassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ActivatePasswordConfirm">Confirm password</label>
        <input type="password" id="ActivatePasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--accent button--full">Activate account</button>
      <button type="submit" name="decline" class="button button--secondary button--full" style="margin-top:0.8rem;">Decline invitation</button>
    {%- endform -%}
  </div>
</div>
