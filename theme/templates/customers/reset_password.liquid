<div class="page-width section">
  <div class="auth-card">
    <h1 style="text-align:center;">{{ 'customer.recover_password.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p style="color:var(--color-accent);">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.login_page.password' | t }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">Confirm password</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--accent button--full">{{ 'customer.recover_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
