<div class="page-width section">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:2.4rem;">
    <h1 style="margin:0;">{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="button button--secondary button--small">{{ 'customer.log_out' | t }}</a>
  </div>

  <div class="account-layout">
    <aside>
      <nav>
        <a href="{{ routes.account_url }}" class="account-nav__link">{{ 'customer.orders.title' | t }}</a>
        <a href="{{ routes.account_addresses_url }}" class="account-nav__link">{{ 'customer.account.view_addresses' | t }}</a>
        <a href="{{ routes.account_logout_url }}" class="account-nav__link">{{ 'customer.log_out' | t }}</a>
      </nav>
      <div style="margin-top:2.4rem;">
        <h3 class="footer__heading" style="color:var(--color-text);">{{ 'customer.account.details' | t }}</h3>
        <p style="font-size:1.4rem;">{{ customer.name }}<br>{{ customer.email }}</p>
        {%- if customer.default_address -%}
          <p class="text-muted" style="font-size:1.3rem;">{{ customer.default_address | format_address }}</p>
        {%- endif -%}
      </div>
    </aside>

    <div>
      <h2 style="font-size:2.2rem;">{{ 'customer.orders.title' | t }}</h2>
      {%- if customer.orders.size > 0 -%}
        <div style="overflow-x:auto;">
          <table class="account-table">
            <thead>
              <tr>
                <th>{{ 'customer.orders.order_number' | t }}</th>
                <th>{{ 'customer.orders.date' | t }}</th>
                <th>{{ 'customer.orders.payment_status' | t }}</th>
                <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th>{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" class="link" style="border:0;">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_net_amount | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- else -%}
        <p class="text-muted">{{ 'customer.orders.none' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--accent">{{ 'cart.general.continue_shopping' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</div>
